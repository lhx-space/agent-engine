{
  "name": "@lhx-agent-engine/config",
  "version": "0.1.0",
  "description": "配置加载与 Schema —— YAML/JSON/TS 三格式归一化为 AgentConfig",
  "keywords": [
    "lhx-agent-engine"
  ],
  "license": "MIT",
  "author": "luhanxin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lhx-space/agent-engine.git",
    "directory": "packages/config"
  },
  "homepage": "https://github.com/lhx-space/agent-engine/tree/main/packages/config#readme",
  "bugs": {
    "url": "https://github.com/lhx-space/agent-engine/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./schema": {
      "import": {
        "types": "./dist/schema/index.d.mts",
        "default": "./dist/schema/index.mjs"
      },
      "require": {
        "types": "./dist/schema/index.d.cts",
        "default": "./dist/schema/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jiti": "^2.7.0",
    "json5": "^2.2.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
