{
  "name": "@agent-engine/core",
  "version": "0.1.0",
  "description": "Agent 内核执行引擎 —— Loop/编排/插件/hooks/rules 装配",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "dependencies": {
    "@agent-engine/config": "workspace:*",
    "@anthropic-ai/sdk": "^0.120.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "gray-matter": "^4.0.3",
    "minisearch": "^7.2.0",
    "openai": "^7.5.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  }
}
