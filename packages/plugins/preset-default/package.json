{
  "name": "@lhx-agent-engine/preset-default",
  "version": "0.1.0",
  "description": "默认全家桶：聚合全部能力插件（rules/skills/documents/memory/web/mcp + files/bash/git + guardrails）",
  "keywords": [
    "lhx-agent-engine"
  ],
  "license": "MIT",
  "author": "luhanxin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lhx-space/agent-engine.git",
    "directory": "packages/plugins/preset-default"
  },
  "homepage": "https://github.com/lhx-space/agent-engine/tree/main/packages/plugins/preset-default#readme",
  "bugs": {
    "url": "https://github.com/lhx-space/agent-engine/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lhx-agent-engine/config": "workspace:*",
    "@lhx-agent-engine/core": "workspace:*",
    "@lhx-agent-engine/plugin-bash": "workspace:*",
    "@lhx-agent-engine/plugin-documents": "workspace:*",
    "@lhx-agent-engine/plugin-files": "workspace:*",
    "@lhx-agent-engine/plugin-git": "workspace:*",
    "@lhx-agent-engine/plugin-guardrails": "workspace:*",
    "@lhx-agent-engine/plugin-mcp": "workspace:*",
    "@lhx-agent-engine/plugin-memory": "workspace:*",
    "@lhx-agent-engine/plugin-otel": "workspace:*",
    "@lhx-agent-engine/plugin-pgvector": "workspace:*",
    "@lhx-agent-engine/plugin-redis": "workspace:*",
    "@lhx-agent-engine/plugin-rules": "workspace:*",
    "@lhx-agent-engine/plugin-skills": "workspace:*",
    "@lhx-agent-engine/plugin-web": "workspace:*"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
