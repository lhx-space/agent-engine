{
  "name": "@agent-engine/plugin-rules",
  "version": "0.1.0",
  "description": "规则上下文注入插件（always 全注入 + on-demand BM25/向量 RRF 检索注入）",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agent-engine/config": "workspace:*",
    "@agent-engine/core": "workspace:*",
    "minisearch": "^7.2.0"
  }
}
