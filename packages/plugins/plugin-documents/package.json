{
  "name": "@agent-engine/plugin-documents",
  "version": "0.1.0",
  "description": "文档 RAG 插件（归一化 → 分块 → 索引 → 检索注入 [文档]）",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agent-engine/config": "workspace:*",
    "@agent-engine/core": "workspace:*",
    "epub2": "^3.0.2",
    "mammoth": "^1.12.1",
    "minisearch": "^7.2.0",
    "turndown": "^7.2.0",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@types/turndown": "^5.0.5"
  }
}
