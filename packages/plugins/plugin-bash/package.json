{
  "name": "@lhx-agent-engine/plugin-bash",
  "version": "0.1.0",
  "description": "沙箱命令执行工具插件（bash，白/黑名单约束 + 网络开关）",
  "keywords": [
    "lhx-agent-engine"
  ],
  "license": "MIT",
  "author": "luhanxin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lhx-space/agent-engine.git",
    "directory": "packages/plugins/plugin-bash"
  },
  "homepage": "https://github.com/lhx-space/agent-engine/tree/main/packages/plugins/plugin-bash#readme",
  "bugs": {
    "url": "https://github.com/lhx-space/agent-engine/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lhx-agent-engine/config": "workspace:*",
    "@lhx-agent-engine/core": "workspace:*"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
